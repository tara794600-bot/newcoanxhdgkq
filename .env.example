# 이 파일을 .env.local로 복사하고 사용하는 기능의 값을 입력하세요.
# VITE_* 값은 브라우저에 공개됩니다. 서비스 계정 JSON과 서버 비밀키는 넣지 마세요.
# npm run dev는 프런트엔드만 실행하므로 /api/*는 별도의 서버 실행 환경이 필요합니다.
# 배포 시에는 사용하는 값을 Vercel 프로젝트 환경 변수에도 등록하세요.

# [필수: Firebase 클라이언트] Firebase 콘솔 > 프로젝트 설정 > 웹 앱의 구성 값
# 아래 6개 항목을 모두 입력하세요. 서버 서비스 계정과 같은 Firebase 프로젝트를 사용하세요.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# [선택: 관리자 회원가입] 비워두면 관리자 회원가입을 사용할 수 없습니다.
# 이 값도 브라우저에 공개되는 클라이언트 설정입니다.
VITE_ADMIN_INVITE_CODE=
# 기존 변수명을 쓰려면 위 VITE_ADMIN_INVITE_CODE 줄을 삭제하고 아래 주석을 해제하세요.
# VITE_STAFF_INVITE_CODE=

# [선택: API 주소] 비워두면 각각 /api/consultation, /api/powerlink/generate를 사용합니다.
# 프런트엔드와 API를 따로 실행하면 API 서버의 전체 URL을 입력하세요.
VITE_CONSULTATION_API_URL=
VITE_POWERLINK_GENERATE_API_URL=

# [선택: 파워링크 경로] 서버의 POWERLINK_PATH_PREFIX와 동일하게 설정하세요.
VITE_POWERLINK_PATH_PREFIX=/p/

# [필수: 서버 Firebase] 상담 저장, 업체 페이지, 사이트맵, RSS, 파워링크 관리자 인증
# Firebase 콘솔에서 발급한 서비스 계정 JSON 전체를 한 줄로 입력하세요.
# .env.local에서는 JSON을 작은따옴표로 감싸고 private_key의 줄바꿈은 \n으로 유지하세요.
# 형식 예시: FIREBASE_SERVICE_ACCOUNT_JSON='{"type":"service_account","project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n","client_email":"your-service-account@your-project-id.iam.gserviceaccount.com"}'
# Vercel 환경 변수 입력란에는 바깥 작은따옴표 없이 JSON 자체를 입력하세요.
# 비워두면 아래 GOOGLE_SERVICE_ACCOUNT_JSON을 Firebase 인증에도 사용합니다.
FIREBASE_SERVICE_ACCOUNT_JSON=

# [선택: Google Sheets 상담 기록] 연동하려면 서비스 계정 JSON과 시트 ID를 모두 입력하세요.
# JSON 입력 형식은 위와 같습니다. Firebase 인증을 겸하면 같은 프로젝트의 계정을 사용하세요.
# 대상 스프레드시트를 서비스 계정의 client_email에 편집자로 공유하세요.
# GOOGLE_SHEET_ID: 스프레드시트 URL의 /d/와 /edit 사이 값
# GOOGLE_SHEET_NAME: 문서 안의 탭 이름 (기본값: Sheet1)
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=Sheet1

# [선택: Telegram 상담 알림] 두 값을 모두 입력해야 알림을 보냅니다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# [파워링크 사용 시 필수] URL 생성과 상담 키워드 복호화에 같은 서버 비밀키를 사용하세요.
# 충분히 긴 무작위 값을 입력하세요. 변경하면 기존 URL의 키워드를 복호화할 수 없습니다.
# CLI는 .env.local을 자동 로드하지 않습니다. 파일을 로드하여 실행하는 예:
# node --env-file=.env.local scripts/generate-powerlink-url.mjs "코인 사기 변호사"
POWERLINK_URL_SECRET=
POWERLINK_PATH_PREFIX=/p/
# URL 생성 시 별도 baseUrl을 전달하지 않았을 때 사용할 주소입니다.
POWERLINK_BASE_URL=https://www.naranfintech.com

# [선택: API CORS] 기본값은 *입니다. 제한하려면 허용할 프런트엔드 origin 하나를 입력하세요.
# 예: https://www.naranfintech.com 또는 http://localhost:5173
CORS_ALLOW_ORIGIN=*
